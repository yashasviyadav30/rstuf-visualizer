            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Awaiting Signatures"
          },
          "keys": {
            "items": {
              "$ref": "#/components/schemas/KeySummary"
            },
            "type": "array",
            "title": "Keys"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "title": "StatusResponse",
