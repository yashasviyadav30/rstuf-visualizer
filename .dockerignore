# Keep the build context to what the image actually needs: the backend's
# application code, its dependency lock, and the interface.

.git
.gitignore
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv

backend/tests
backend/fixtures
backend/scripts
backend/Makefile
.pre-commit-config.yaml

charts
docs
*.md
Dockerfile
.dockerignore

# Installed inside the build stage, from the lockfile.
frontend/node_modules
frontend/dist
