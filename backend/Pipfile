# The libraries this service needs, by name only. Pipfile.lock pins the exact
# versions and their hashes, and that is what every install reads.

[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
pydantic-settings = "*"
tuf = "*"
securesystemslib = {extras = ["crypto"], version = "*"}
httpx = "*"

[dev-packages]
black = "*"
isort = "*"
flake8 = "*"
bandit = "*"
tox = "*"
coverage = "*"
pytest = "*"
pytest-asyncio = "*"
pytest-cov = "*"
pytest-xdist = "*"
pre-commit = "*"

[requires]
python_version = "3.13"
